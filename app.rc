#include <windows.h>
#include <winver.h>

#define IDI_APP 101

// multi-size icon group (32x32 / 48x48 / 64x64 inside app.ico);
// Windows picks the best match per context (tray / title bar / Alt+Tab)
IDI_APP ICON "app.ico"

// RT_MANIFEST (type 24). Declares DPI awareness (without it the window is
// bitmap-scaled and blurry on 125%/150% displays) and pulls in ComCtl32 v6 so
// the tab / list / progress controls get the modern look instead of Win95.
1 24 "app.manifest"

// executable version info shown in Properties -> Details
VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,5,4,0
 PRODUCTVERSION 1,5,4,0
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404b0"
        BEGIN
            VALUE "FileDescription", "LNPP 组件管理器"
            VALUE "FileVersion", "1.5.4.0"
            VALUE "InternalName", "lnpp"
            VALUE "OriginalFilename", "lnpp.exe"
            VALUE "ProductName", "LNPP 组件管理器"
            VALUE "ProductVersion", "1.5.4.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0804, 1200
    END
END
