# build / runtime artifacts
build/
*.exe
*.obj
*.res
*.user

# third-party component binaries (hundreds of MB, manually copied)
bin/

# runtime data & sensitive files
data/
backup/
logs/
ssl/

# unrelated / user-specific files
packages.conf
# per-site nginx configs are user data; keep only the templates tracked
etc/nginx/vhosts/*.conf
!etc/nginx/vhosts/_template*.conf

# test-generated / user-created www sites (keep the dir via www/.gitkeep)
www/*/
!www/.gitkeep

# misc
Thumbs.db
Desktop.ini

# WorkBuddy project data
.workbuddy/
